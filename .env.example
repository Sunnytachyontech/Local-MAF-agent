# Foundry Local model used by demo_agent.py
#
# IMPORTANT: do NOT use phi-4-mini here. It is advertised in the Foundry Local
# catalog with supports_tool_calling=True, but it cannot actually make
# structured tool calls -- it emits them as plain message text, so the tool
# never executes and the raw JSON leaks into the answer.
#
# qwen3-4b (2.7 GB) is verified working. qwen2.5-7b (6.3 GB) also works.
FOUNDRY_LOCAL_MODEL=qwen3-4b
